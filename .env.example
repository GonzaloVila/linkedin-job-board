# Same DATABASE_URL as the bot - pointing to the same Neon database
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.neon.tech/neondb?sslmode=require

# Basic auth password for the dashboard
# Anyone who knows this can view the board. Pick something only you know.
DASHBOARD_PASSWORD=changeme

# ── AI layer (Groq — free tier, sin tarjeta) ─────────────────────────────────
# Obtené tu API key gratis en https://console.groq.com → API Keys
GROQ_API_KEY=gsk_...

# Modelo por defecto. Opciones Groq: llama-3.3-70b-versatile | llama3-8b-8192
# LLM_MODEL_PRIMARY=llama-3.3-70b-versatile

# ── Auto-apply: bot → job-board ───────────────────────────────────────────
# Secreto compartido con linkedin-bot: el bot llama a POST /api/process-new
# con este valor en el header x-webhook-secret. Generá algo random (ej: openssl rand -hex 24).
BOT_WEBHOOK_SECRET=

# Bot de Telegram (Tier B: aprobar/descartar con un tap). Creá uno con
# @BotFather (/newbot), conseguí tu chat_id hablándole a @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Secreto para el webhook de Telegram (Tier B, callback de los botones).
# Se configura una vez llamando a setWebhook con este mismo valor como
# secret_token — ver README, sección "Configurar el bot de Telegram".
TELEGRAM_WEBHOOK_SECRET=

# ── Auto-apply: Tier A (email, 100% automático) ───────────────────────────
# Envía por el SMTP real de Gmail (App Password) — el recruiter ve
# "From: gonzalovila08@gmail.com" genuino, autenticado por Google.
# Requiere 2FA activo en la cuenta: generá el App Password en
# https://myaccount.google.com/apppasswords (16 caracteres, sin espacios).
GMAIL_USER=gonzalovila08@gmail.com
GMAIL_APP_PASSWORD=

# PDF real de tu CV, adjuntado en los mails de Tier A. Por default se lee
# de public/resume.pdf (commiteado al repo); RESUME_PDF_URL lo pisa si
# preferís servirlo desde otro lado (ej: Vercel Blob) sin redeploy.
# RESUME_PDF_URL=

# Interruptor general del canal de email — déjalo en false hasta tener
# public/resume.pdf y GMAIL_APP_PASSWORD configurados.
TIER_A_EMAIL_ENABLED=false

# URL pública del dashboard, usada solo para linkear cuando un mensaje de
# Telegram se trunca por el límite de 4096 caracteres.
# DASHBOARD_URL=https://your-job-board.vercel.app
