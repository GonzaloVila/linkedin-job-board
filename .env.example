# Same DATABASE_URL as the bot - pointing to the same Neon database
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.neon.tech/neondb?sslmode=require

# Basic auth password for the dashboard
# Anyone who knows this can view the board. Pick something only you know.
DASHBOARD_PASSWORD=changeme

# ── AI layer (Cerebras — free tier, 1M tokens/día) ───────────────────────────
# Obtené tu API key gratis en https://cloud.cerebras.ai → API Keys
CEREBRAS_API_KEY=csk-...

# Modelo por defecto. Opciones Cerebras: llama-3.3-70b | llama3.1-8b
# LLM_MODEL_PRIMARY=llama-3.3-70b
